// Tablas nuevas en tu base MySQL/MariaDB (no toca websoldadura.comandes).
// Tras copiar el proyecto: edita .env y ejecuta bash setup.sh (o npm run instalar).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// ============================
/// Tablas existentes (LEGACY)
/// ============================
/// Estas tablas YA existen en tu BD (`websoldadura`) y **no deben modificarse**.
/// Las declaramos para que Prisma **NO intente borrarlas** al hacer `prisma db push`.
/// Con `@@ignore` NO se generan en el Prisma Client, pero sí se “reconocen” a nivel de esquema.
model ComandesLegacy {
  idComanda      Int      @id @map("idComanda")
  numComanda     String?  @map("numComanda") @db.VarChar(255)
  reparacion     String?  @map("reparacion") @db.Text
  nomProveedor   String?  @map("nomProveedor") @db.VarChar(255)
  codiPieza      String?  @map("codiPieza") @db.VarChar(255)
  codigoFab      String?  @map("codigoFab") @db.VarChar(255)
  cantidad       Int?     @map("cantidad")
  codigoConjunto String?  @map("codigoConjunto") @db.VarChar(255)
  OP             String?  @map("OP") @db.VarChar(255)
  tipus          String?  @map("tipus") @db.VarChar(255)
  fechaInsercion DateTime? @map("fechaInsercion")
  cerrada        Boolean? @map("cerrada")

  @@map("comandes")
  @@ignore
}

model UsersLegacy {
  idusers  Int     @id @map("idusers")
  nomuser  String? @map("nomuser") @db.VarChar(255)
  password String? @map("password") @db.VarChar(255)
  rol      String? @map("rol") @db.VarChar(255)

  @@map("users")
  @@ignore
}

enum Rol {
  ADMIN
  PROVEEDOR
}

enum EstadoPieza {
  PENDIENTE
  HECHA
  ENVIADA
  RECIBIDA
  REVISAR
}

enum EstadoComanda {
  ABIERTA
  EN_PROCESO
  ENVIADA
  RECIBIDA_PARCIAL
  COMPLETADA
}

/// Estado extendido por línea (PK = idComanda de la tabla legacy `comandes`). No altera `comandes`.
enum EstadoLineaComandesExt {
  ENVIADA_PROVEEDOR
  RECIBIDA_EMPRESA
}

model LineaComandesEstado {
  id               String                 @id @default(cuid())
  /// Coincide con comandes.idComanda
  idLineaComandes  Int                    @unique @map("id_linea_comandes")
  nomProveedor     String                 @map("nom_proveedor") @db.VarChar(255)
  numComanda       String                 @map("num_comanda") @db.VarChar(255)
  estado           EstadoLineaComandesExt @default(ENVIADA_PROVEEDOR)
  enviadoAt        DateTime               @default(now()) @map("enviado_at")
  recibidoAt       DateTime?              @map("recibido_at")

  @@index([nomProveedor, numComanda])
  @@index([estado])
  @@map("lineas_comandes_estado")
}

model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol
  /// Debe coincidir con nomProveedor de la comanda para filtrar vistas de proveedor
  proveedor String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  historial HistorialEstado[]

  @@map("usuarios")
}

/// Copia sincronizada desde la lógica de negocio (origen: websoldadura.comandes)
model Comanda {
  id             String        @id @default(cuid())
  numComanda     String        @unique @map("num_comanda")
  reparacion     String?       @db.Text
  nomProveedor   String        @map("nom_proveedor")
  estado         EstadoComanda @default(ABIERTA)
  fechaInsercion DateTime?     @map("fecha_insercion")
  cerrada        Boolean       @default(false)
  fechaSync      DateTime?     @map("fecha_sync")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  piezas PiezaComanda[]

  @@index([nomProveedor])
  @@index([estado])
  @@map("comandas")
}

model PiezaComanda {
  id             String      @id @default(cuid())
  comandaId      String      @map("comanda_id")
  comanda        Comanda     @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  /// idComanda de la fila original en websoldadura.comandes (opcional, único si existe)
  idLineaOrigen  Int?        @unique @map("id_linea_origen")
  codiPieza      String      @map("codi_pieza")
  codigoFab      String?     @map("codigo_fab")
  cantidad       Int
  codigoConjunto String?     @map("codigo_conjunto")
  op             String?     @map("op")
  tipus          String?     @db.VarChar(64)
  estado         EstadoPieza @default(PENDIENTE)
  comentarios    String?     @db.Text
  fechaEstado    DateTime?   @map("fecha_estado")

  historial HistorialEstado[]

  @@index([comandaId])
  @@map("piezas_comanda")
}

model HistorialEstado {
  id             String       @id @default(cuid())
  piezaId        String       @map("pieza_id")
  pieza          PiezaComanda @relation(fields: [piezaId], references: [id], onDelete: Cascade)
  usuarioId      String?      @map("usuario_id")
  usuario        Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  fecha          DateTime     @default(now())
  estadoAnterior EstadoPieza? @map("estado_anterior")
  estadoNuevo    EstadoPieza  @map("estado_nuevo")
  comentario     String?      @db.Text

  @@index([piezaId])
  @@map("historial_estados")
}
