# Copia este archivo a .env en el VPS (nunca subas .env al repositorio).
# Base de datos MySQL/MariaDB (misma instancia donde está websoldadura o la que uses para las tablas nuevas)
DATABASE_URL="mysql://USUARIO_MYSQL:CONTRASEÑA@127.0.0.1:3306/NOMBRE_BASE_DATOS"

# Secreto para firmar JWT (genera uno largo y aleatorio, p. ej. openssl rand -base64 48)
JWT_SECRET="cambiar_por_un_secreto_largo_y_unico"

# URL pública de la aplicación (sin barra final). Debe coincidir con cómo entras en el navegador
# (mismo protocolo: http si no tienes certificado, https si usas TLS). Ej.: http://TU_IP:3000
NEXT_PUBLIC_APP_URL="https://tu-dominio-o-ip.com"

# Opcional: fuerza flag Secure en la cookie de sesión (true/false). Si no lo pones, en producción
# solo se usa Secure si NEXT_PUBLIC_APP_URL empieza por https:// (evita login roto vía HTTP).

# SESSION_COOKIE_SECURE=false

# Puerto interno donde escucha Next.js (Nginx hará proxy aquí)
PORT=3000

# Node
NODE_ENV=production

# Opcional: permitir registro de usuarios vía API solo en desarrollo (si implementas la bandera)
# ALLOW_REGISTER=false
